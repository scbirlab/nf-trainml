manifest {

    author          = "Eachan Johnson"
    homePage        = "https://github.com/scbirlab/nf-trainml"
    description     = "Nextflow pipeline template."
    defaultBranch   = "v0.0.1"
    nextflowVersion = '!>=24.00.0,<26'
    version         = "0.0.1"
    doi             = ''

}

params {

    help = false

    /* Required */
    sample_sheet = null

    /* Optional */
    inputs = "inputs"
    outputs = "outputs"

    train = .7
    validation = .15
    test = .15
    k = 3  // for FAISS split, number of neighbors
    batch_size = 16
    epochs = 10
    n_partitions = 100
    invert = false
    split_replicates = 3

    skip_plot = false

}

process {
  container = 'ghcr.io/scbirlab/nf-trainml:latest'
  containerEngine = 'auto'  // docker, singularity, or podman
  conda = "${projectDir}/environment.yml"
}

conda {
  createTimeout = "3h"
  cacheDir = "${projectDir}/.conda"
}

singularity {
  autoMounts = true
  cacheDir = "${projectDir}/.singularity"
  runOptions = "--network=none"
}

docker {
  cacheDir = "${projectDir}/.docker"
  temp = true  // run in isolated container mount
}

profiles {

  standard {

    singularity.enabled = false
    conda.enabled = true

    process {
      executor = 'slurm'
      memory = 8.GB
      cpus = 1
      array = 100
      time = '5h'

      withLabel: big_cpu {
        cpus = 16
        memory = 64.GB
      }

      withLabel: some_mem {
        memory = 8.GB
      }

      withLabel: med_mem {
        memory = 32.GB
      }

    }

    dag {
      enabled = true
      overwrite = true
    }

    notification {
      enabled = true
      to = "$USER@crick.ac.uk"
    }

  }

  local {

    conda.enabled = true

    process {
      executor = 'local'
      memory = 16.GB
      cpus = 1
      time = '2h'

      withLabel: big_cpu {
        cpus = 2
      }

    }

  }

  gh {

    docker.enabled = true
    docker.runOptions = '-u 1001:1001'

    process {
      executor = 'local'
      cpus = 1
      memory = 12.GB
    }

  }

}